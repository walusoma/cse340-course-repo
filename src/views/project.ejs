<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= project.title %>
        </h2>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <p>
            <strong>Date:</strong>
            <%= project.date %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Description:</strong>
            <%= project.description %>
        </p>

        <h3>Categories</h3>

        <% if (categories && categories.length> 0) { %>
            <ul style="list-style-type: none; padding: 0; display: flex; gap: 10px; flex-wrap: wrap;">
                <% categories.forEach(category=> { %>
                    <li style="background-color: #e2e8f0; border-radius: 4px; padding: 4px 8px;">
                        <a href="/category/<%= category.category_id %>" style="text-decoration: none; color: #1e293b;">
                            🏷️ <%= category.name %>
                        </a>
                    </li>
                    <% }); %>
            </ul>
            <% } else { %>
                <p>No category tags assigned.</p>
                <% } %>

                    <% if (user) { %>
                        <h3>Volunteering</h3>

                        <% if (isVolunteer) { %>
                            <p>You are volunteering for this project.</p>

                            <p>
                                <a href="/project/<%= project.project_id %>/remove-volunteer">
                                    Remove Yourself as a Volunteer
                                </a>
                            </p>
                            <% } else { %>
                                <p>
                                    <a href="/project/<%= project.project_id %>/volunteer">
                                        Volunteer for this Project
                                    </a>
                                </p>
                                <% } %>
                                    <% } %>

                                        <% if (user && user.role_name==='admin' ) { %>
                                            <p>
                                                <a href="/edit-project/<%= project.project_id %>">
                                                    Edit Project
                                                </a>
                                                |
                                                <a href="/assign-categories/<%= project.project_id %>">
                                                    Edit Categories
                                                </a>
                                            </p>
                                            <% } %>
    </main>

    <%- include('partials/footer') %>