<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= category.name %>
        </h2>

        <h3>Service Projects in this Category</h3>
        <% if (projects.length> 0) { %>
            <ul>
                <% projects.forEach(project=> { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <strong>
                                <%= project.title %>
                            </strong>
                        </a>
                        — Hosted by
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </li>
                    <% }); %>
            </ul>
            <% } else { %>
                <p>No service projects found for this category.</p>
                <% } %>
    </main>

    <%- include('partials/footer') %>